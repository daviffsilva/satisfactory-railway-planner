{
  "name": "satisfactory-railway-planner",
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive railway planner for Satisfactory game",
  "private": true,
  "homepage": "https://daviffsilva.github.io/satisfactory-railway-planner",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "immer": "^10.2.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "test": "vitest",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "gh-pages": "^4.0.0",
    "typescript": "^5.2.2",
    "vite": "^4.5.0",
    "vitest": "^1.0.4"
  }
}
